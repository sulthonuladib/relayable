CARGO_NET_OFFLINE=true cargo check --locked                         # exit 0
CARGO_NET_OFFLINE=true cargo test --locked                          # exit 0, 58 passed

cd <repo root>
CARGO_NET_OFFLINE=true cargo build -p relayable-server --locked     # exit 0

RELAYABLE_SERVER=<scratch sock> RELAYABLE_STATE_DIR=<scratch state> SHELL=/bin/bash \
    ./target/debug/relayable-server run &
cd apps/linux && RELAYABLE_SERVER=<scratch sock> timeout 60 cargo run --locked --bin live-probe
```

